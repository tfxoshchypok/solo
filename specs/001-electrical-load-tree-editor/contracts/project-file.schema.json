{
  "$id": "https://eltree.local/schemas/project-file.schema.json",
  "title": "Electrical consumer tree project file (.eltree.json)",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "integer"
    },
    "catalogVersion": {
      "type": "string"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "createdAt": {
      "type": "string"
    },
    "modifiedAt": {
      "type": "string"
    },
    "rootId": {
      "type": "string",
      "minLength": 1
    },
    "nodes": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              },
              "note": {
                "type": "string",
                "maxLength": 2000
              },
              "kind": {
                "const": "entry"
              },
              "parentId": {
                "type": "null"
              },
              "childIds": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "childrenKind": {
                "enum": [
                  "undecided",
                  "panels",
                  "consumers"
                ],
                "type": "string"
              }
            },
            "required": [
              "id",
              "name",
              "kind",
              "parentId",
              "childIds",
              "childrenKind"
            ]
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              },
              "note": {
                "type": "string",
                "maxLength": 2000
              },
              "kind": {
                "const": "panel"
              },
              "parentId": {
                "type": "string",
                "minLength": 1
              },
              "childIds": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "childrenKind": {
                "enum": [
                  "undecided",
                  "panels",
                  "consumers"
                ],
                "type": "string"
              }
            },
            "required": [
              "id",
              "name",
              "kind",
              "parentId",
              "childIds",
              "childrenKind"
            ]
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              },
              "note": {
                "type": "string",
                "maxLength": 2000
              },
              "kind": {
                "const": "consumer"
              },
              "parentId": {
                "type": "string",
                "minLength": 1
              },
              "childIds": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "maxItems": 0
              },
              "typeId": {
                "type": "string",
                "minLength": 1
              },
              "typeName": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              },
              "quantity": {
                "type": "integer",
                "minimum": 1
              }
            },
            "required": [
              "id",
              "name",
              "kind",
              "parentId",
              "childIds",
              "typeId",
              "typeName",
              "quantity"
            ]
          }
        ]
      }
    }
  },
  "required": [
    "schemaVersion",
    "catalogVersion",
    "name",
    "createdAt",
    "modifiedAt",
    "rootId",
    "nodes"
  ],
  "$schema": "http://json-schema.org/draft-07/schema#"
}
