    "modifiedAt": {
      "type": "string"
    },
    "rootId": {
      "type": "string",
      "minLength": 1
    },
    "nodes": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              },
              "note": {
                "type": "string",
                "maxLength": 2000
              },
              "kind": {
                "const": "entry"
              },
              "parentId": {
                "type": "null"
              },
              "childIds": {
