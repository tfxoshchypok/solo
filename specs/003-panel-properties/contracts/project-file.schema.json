                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "moduleReservePct": {
                    "anyOf": [
                      {
                        "type": "number",
                        "minimum": 0
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "separateRcdMode": {
                    "anyOf": [
                      {
