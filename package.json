{
  "name": "eltree",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Electrical Consumer Tree Editor — local-first NeutralinoJS desktop app",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite",
